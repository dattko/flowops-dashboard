meta {
  name: Get Storefront Products
  type: http
  seq: 1
  tags: [
    read
    public
  ]
}

post {
  url: {{supabase_url}}/rest/v1/rpc/get_storefront_products
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Content-Type: application/json
}

body:json {
  {
    "p_page": 1,
    "p_page_size": 24,
    "p_keyword": null,
    "p_category": null,
    "p_sort": "featured"
  }
}

tests {
  test("고객용 상품 목록 조회 성공", function () {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
    expect(res.body.totalCount).to.be.a("number");
  });
}
