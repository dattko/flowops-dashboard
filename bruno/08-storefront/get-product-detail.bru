meta {
  name: Get Storefront Product Detail
  type: http
  seq: 2
  tags: [
    read
    public
  ]
}

post {
  url: {{supabase_url}}/rest/v1/rpc/get_storefront_product_detail
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Content-Type: application/json
}

body:json {
  {
    "p_slug": "bean-house-200"
  }
}

tests {
  test("고객용 상품 상세 조회 성공", function () {
    expect(res.status).to.equal(200);
    expect(res.body.slug).to.equal("bean-house-200");
    expect(res.body.available).to.be.a("number");
  });
}
