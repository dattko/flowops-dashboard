meta {
  name: Get Inventory Detail
  type: http
  seq: 2
  tags: [
    read
  ]
}

post {
  url: {{supabase_url}}/rest/v1/rpc/get_inventory_detail
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "p_product_id": "{{product_id}}"
  }
}

tests {
  test("재고 상세 조회 성공", function () {
    expect(res.status).to.equal(200);
    expect(res.body.productId).to.equal(bru.getEnvVar("product_id"));
    expect(res.body.movements).to.be.an("array");
  });
}
