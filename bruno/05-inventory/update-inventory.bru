meta {
  name: [변경] Update Inventory
  type: http
  seq: 2
  tags: [
    write
  ]
}

post {
  url: {{supabase_url}}/rest/v1/rpc/update_inventory
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "p_product_id": "{{product_id}}",
    "p_payload": {
      "onHand": 100,
      "reserved": 5,
      "reorderPoint": 10
    }
  }
}

tests {
  test("재고 수정 성공", function () {
    expect(res.status).to.equal(200);
  });
}
