meta {
  name: [변경] Adjust Inventory Stock
  type: http
  seq: 5
  tags: [
    write
  ]
}

post {
  url: {{supabase_url}}/rest/v1/rpc/adjust_inventory_stock
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "p_product_id": "{{product_id}}",
    "p_payload": {
      "movementType": "inbound",
      "quantity": 10,
      "reason": "API 테스트 입고"
    }
  }
}

tests {
  test("재고 변경 및 이력 등록 성공", function () {
    expect(res.status).to.equal(200);
    expect(res.body.movements).to.be.an("array");
  });
}
