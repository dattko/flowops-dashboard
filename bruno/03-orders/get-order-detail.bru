meta {
  name: Get Order Detail
  type: http
  seq: 2
  tags: [
    read
  ]
}

post {
  url: {{supabase_url}}/rest/v1/rpc/get_order_detail
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "p_order_id": "{{order_id}}"
  }
}

tests {
  test("주문 상세 조회 성공", function () {
    expect(res.status).to.equal(200);
  });
}
