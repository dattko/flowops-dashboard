meta {
  name: [변경] Update Order Detail
  type: http
  seq: 3
  tags: [
    write
  ]
}

post {
  url: {{supabase_url}}/rest/v1/rpc/update_order_detail
  body: json
  auth: none
}

headers {
  apikey: {{publishable_key}}
  Authorization: Bearer {{access_token}}
  Content-Type: application/json
}

body:json {
  {
    "p_order_id": "{{order_id}}",
    "p_payload": {
      "customerPhone": "010-1234-5678"
    }
  }
}

tests {
  test("주문 수정 성공", function () {
    expect(res.status).to.equal(200);
  });
}
